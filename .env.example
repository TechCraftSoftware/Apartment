# ============================================================================
# SINGLE-CLIENT APARTMENT BOOKING PLATFORM — ENVIRONMENT CONFIGURATION
# ============================================================================

# 1. Paystack Test Mode Configuration
# Use Paystack TEST keys only (never use live sk_live_ or pk_live_ keys here).
# If PAYSTACK_SECRET_KEY is omitted, the server automatically runs in clearly
# labelled SIMULATED_TEST_MODE so local checkout and callback verification work
# out of the box without external network dependencies.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_replace_with_your_paystack_test_public_key
PAYSTACK_SECRET_KEY=sk_test_replace_with_your_paystack_test_secret_key

# 2. Application Base URL (used for Paystack callback_url generation)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 3. Database Persistence Path (JSON-backed Modular Monolith Repository)
# Defaults to ./data/platform-db.json if omitted
PLATFORM_DB_PATH=./data/platform-db.json

# 4. Customer Booking Verification Code Policy
VERIFICATION_CODE_EXPIRY_MINUTES=30

# 5. Customer Email Delivery (SMTP)
# Booking access codes, booking details and confirmation emails are sent over
# SMTP. Leave SMTP_HOST empty to skip sending and show codes in the on-screen
# development outbox instead. Gmail example: smtp.gmail.com, port 465,
# SMTP_SECURE=true, and an App Password (not your normal password) in SMTP_PASS.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Verdant Stays <reservations@verdantstays.ng>"
